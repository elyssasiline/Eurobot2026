# Dockerfile pour ROS2 Humble sur Raspberry Pi 5
FROM ubuntu:22.04

# Éviter les prompts interactifs
ENV DEBIAN_FRONTEND=noninteractive
ENV ROS_DISTRO=humble
ENV LANG=en_US.UTF-8
ENV LC_ALL=en_US.UTF-8

# Configuration timezone
RUN ln -fs /usr/share/zoneinfo/Europe/Paris /etc/localtime

# Installation des dépendances de base
RUN apt-get update && apt-get install -y \
    locales \
    curl \
    gnupg2 \
    lsb-release \
    software-properties-common \
    && locale-gen en_US.UTF-8 \
    && rm -rf /var/lib/apt/lists/*

# Ajout du dépôt ROS2
RUN curl -sSL https://raw.githubusercontent.com/ros/rosdistro/master/ros.key \
    -o /usr/share/keyrings/ros-archive-keyring.gpg

RUN echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/ros-archive-keyring.gpg] \
    http://packages.ros.org/ros2/ubuntu $(lsb_release -cs) main" \
    | tee /etc/apt/sources.list.d/ros2.list > /dev/null

# Installation ROS2 Humble Desktop
RUN apt-get update && apt-get install -y \
    ros-humble-desktop \
    ros-humble-cv-bridge \
    ros-humble-image-transport \
    ros-humble-camera-calibration \
    ros-humble-camera-info-manager \
    ros-humble-vision-msgs \
    ros-humble-xacro \
    ros-humble-joint-state-publisher \
    ros-humble-robot-state-publisher \
    && rm -rf /var/lib/apt/lists/*

# Outils de développement
RUN apt-get update && apt-get install -y \
    python3-pip \
    python3-colcon-common-extensions \
    python3-rosdep \
    python3-vcstool \
    build-essential \
    git \
    vim \
    nano \
    wget \
    tmux \
    htop \
    && rm -rf /var/lib/apt/lists/*

# Dépendances système pour caméra et GPIO
RUN apt-get update && apt-get install -y \
    python3-opencv \
    python3-numpy \
    libcamera-dev \
    libcamera-tools \
    libcap-dev \
    python3-dev \
    python3-gpiozero \
    python3-serial \
    && rm -rf /var/lib/apt/lists/*

# Installer picamera2 et RPi.GPIO via pip (pas disponibles via apt sur Ubuntu)
RUN pip3 install --no-cache-dir \
    picamera2 \
    RPi.GPIO

# Initialiser rosdep
RUN rosdep init || true
RUN rosdep update

# Créer un utilisateur non-root avec le même UID que sur le host
ARG USER_ID=1000
ARG GROUP_ID=1000
RUN groupadd -g ${GROUP_ID} rosuser || true
RUN useradd -m -u ${USER_ID} -g ${GROUP_ID} -s /bin/bash rosuser
RUN usermod -aG dialout rosuser
RUN usermod -aG video rosuser

# Donner les permissions sudo sans mot de passe
RUN apt-get update && apt-get install -y sudo \
    && rm -rf /var/lib/apt/lists/*
RUN echo "rosuser ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers

# Configuration bashrc
RUN echo "source /opt/ros/humble/setup.bash" >> /home/rosuser/.bashrc
RUN echo "if [ -f /workspace/install/setup.bash ]; then" >> /home/rosuser/.bashrc
RUN echo "  source /workspace/install/setup.bash" >> /home/rosuser/.bashrc
RUN echo "fi" >> /home/rosuser/.bashrc

# Alias utiles pour ROS2
RUN echo "alias cb='cd /workspace && colcon build --symlink-install'" >> /home/rosuser/.bashrc
RUN echo "alias cbs='cd /workspace && colcon build --symlink-install --packages-select'" >> /home/rosuser/.bashrc
RUN echo "alias ct='cd /workspace && colcon test'" >> /home/rosuser/.bashrc
RUN echo "alias ws='cd /workspace'" >> /home/rosuser/.bashrc
RUN echo "alias src='cd /workspace/src'" >> /home/rosuser/.bashrc
RUN echo "alias ss='source /workspace/install/setup.bash'" >> /home/rosuser/.bashrc

# Créer le répertoire de travail
RUN mkdir -p /workspace
RUN chown -R rosuser:rosuser /workspace

WORKDIR /workspace

USER rosuser

CMD ["/bin/bash"]