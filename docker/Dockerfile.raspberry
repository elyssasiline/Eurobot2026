# Dockerfile pour ROS2 Humble sur Raspberry Pi avec support caméra v4l2
FROM osrf/ros:humble-desktop

ENV DEBIAN_FRONTEND=noninteractive
ENV ROS_DISTRO=humble
ENV LANG=en_US.UTF-8
ENV LC_ALL=en_US.UTF-8

# Installation des dépendances de base
RUN apt-get clean && \
    rm -rf /var/lib/apt/lists/* && \
    apt-get update --fix-missing && \
    apt-get install -y --no-install-recommends \
    locales \
    curl \
    gnupg2 \
    lsb-release \
    && locale-gen en_US.UTF-8 \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Note: Python 3.10 est déjà inclus dans l'image osrf/ros:humble-desktop
# On utilise directement python3 et pip3 disponibles

# Packages ROS2 pour vision
RUN apt-get update --fix-missing && \
    apt-get install -y --no-install-recommends \
    ros-humble-cv-bridge \
    ros-humble-image-transport \
    ros-humble-camera-calibration \
    ros-humble-camera-info-manager \
    ros-humble-vision-msgs \
    ros-humble-image-tools \
    ros-humble-usb-cam \
    ros-humble-v4l2-camera \
    ros-humble-xacro \
    ros-humble-joint-state-publisher \
    ros-humble-robot-state-publisher \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Outils de développement
RUN apt-get update --fix-missing && \
    apt-get install -y --no-install-recommends \
    python3-colcon-common-extensions \
    python3-rosdep \
    python3-vcstool \
    build-essential \
    git \
    vim \
    nano \
    wget \
    tmux \
    htop \
    sudo \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Outils v4l2 et support caméra
RUN apt-get update --fix-missing && \
    apt-get install -y --no-install-recommends \
    v4l-utils \
    libv4l-dev \
    libv4l2rds0 \
    uvcdynctrl \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Dépendances Python pour vision
RUN pip3 install --no-cache-dir \
    numpy \
    opencv-contrib-python \
    Pillow

# Initialiser rosdep
RUN rosdep init || true
RUN rosdep update

# Créer utilisateur non-root
ARG USER_ID=1000
ARG GROUP_ID=1000
RUN groupadd -g ${GROUP_ID} rosuser || true
RUN useradd -m -u ${USER_ID} -g ${GROUP_ID} -s /bin/bash rosuser
RUN usermod -aG dialout rosuser
RUN usermod -aG video rosuser
RUN usermod -aG gpio rosuser || true
RUN echo "rosuser ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers

# Configuration bashrc
RUN echo "source /opt/ros/humble/setup.bash" >> /home/rosuser/.bashrc && \
    echo "if [ -f /workspace/install/setup.bash ]; then" >> /home/rosuser/.bashrc && \
    echo "  source /workspace/install/setup.bash" >> /home/rosuser/.bashrc && \
    echo "fi" >> /home/rosuser/.bashrc

# Aliases utiles
RUN echo "alias cb='cd /workspace && colcon build --symlink-install'" >> /home/rosuser/.bashrc && \
    echo "alias cbs='cd /workspace && colcon build --symlink-install --packages-select'" >> /home/rosuser/.bashrc && \
    echo "alias ct='cd /workspace && colcon test'" >> /home/rosuser/.bashrc && \
    echo "alias ws='cd /workspace'" >> /home/rosuser/.bashrc && \
    echo "alias src='cd /workspace/src'" >> /home/rosuser/.bashrc && \
    echo "alias ss='source /workspace/install/setup.bash'" >> /home/rosuser/.bashrc && \
    echo "alias cam='v4l2-ctl --list-devices'" >> /home/rosuser/.bashrc

RUN mkdir -p /workspace
RUN chown -R rosuser:rosuser /workspace

WORKDIR /workspace
USER rosuser

CMD ["/bin/bash"]